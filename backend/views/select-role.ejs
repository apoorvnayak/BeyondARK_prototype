<section class="section">
  <div class="wrap">
    <h2 class="text-center">How will you use BeyondArk?</h2>
    <p class="text-center muted">You can always reach out to support to switch later.</p>

    <div class="role-grid">
      <form action="/select-role" method="POST">
        <input type="hidden" name="role" value="tourist" />
        <button type="submit" class="role-card" style="width:100%">
          <svg class="role-icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/></svg>
          <h3>I'm a Tourist</h3>
          <p class="muted">Discover verified artisans and book authentic local experiences.</p>
        </button>
      </form>

      <form action="/select-role" method="POST">
        <input type="hidden" name="role" value="provider" />
        <button type="submit" class="role-card" style="width:100%">
          <svg class="role-icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8 L12 3 L20 8 L20 20 L4 20 Z"/><path d="M9 20 V13 H15 V20"/></svg>
          <h3>I'm an Artisan / Provider</h3>
          <p class="muted">Get verified and share your craft or experience with travellers.</p>
        </button>
      </form>
    </div>
  </div>
</section>
