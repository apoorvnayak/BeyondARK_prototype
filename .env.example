# ==============================================================
# BeyondArk FRONTEND environment
# This folder is just static CSS/JS deployed on its own (Netlify,
# Vercel, Cloudflare Pages, GitHub Pages, or any static host/CDN).
# It has no server-side logic, so there's very little to configure.
# ==============================================================

# Port for the local static preview server (`npm start` -> `serve`)
PORT=5173

# Reference only - not read by any code here. After deploying this
# folder, put its URL into the BACKEND's ASSET_BASE_URL so the
# server-rendered pages load CSS/JS from here instead of from
# the backend itself.
# e.g. BACKEND_URL=https://beyondark-api.onrender.com
BACKEND_URL=http://localhost:3000
